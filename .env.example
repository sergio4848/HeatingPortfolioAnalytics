# Local demo only. Never deploy demo anonymously with real data.
APP_MODE=demo
DATABASE_URL=sqlite:///./portotherm.db
# Compose database only; choose a random URL-safe password before starting.
POSTGRES_PASSWORD=
# Optional stable local cookie signing key; randomly generated in process when omitted.
SESSION_SECRET=
COOKIE_SECURE=false
TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Pilot mode requires an external OIDC issuer plus server-provisioned membership.
# Never put identity tokens or real customer data in this file/repository.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
